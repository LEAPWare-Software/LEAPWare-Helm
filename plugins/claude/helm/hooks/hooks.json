{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/helm_hook.py"],
            "timeout": 10,
            "statusMessage": "helm: checking dispatch against token policy"
          }
        ]
      }
    ]
  }
}
